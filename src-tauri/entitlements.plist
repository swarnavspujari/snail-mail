<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements for the notarized macOS build.

  Deliberately minimal: notarization rejects an app that asks for more than it
  uses, and every exception here is one the app would break without.

  - network.client        Gmail / Calendar / Drive / Unsplash / the update feed.
  - files.user-selected   Attachment "Save as…" and picking files to attach,
                          both of which go through the system panel.

  NOT present, on purpose:
  - allow-unsigned-executable-memory / allow-jit — WebKit on macOS runs its JIT
    in a separate, already-entitled process. Granting them here would weaken
    the runtime for nothing.
  - camera / microphone / location / address-book — never touched.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
